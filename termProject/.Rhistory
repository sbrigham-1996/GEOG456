# 2) Define your 50 states in 5 chunks of 10
state_chunks <- list(
c("ALABAMA","ALASKA","ARIZONA","ARKANSAS","CALIFORNIA",
"CONNECTICUT","DELAWARE","FLORIDA","GEORGIA","HAWAII"),
c("IDAHO","ILLINOIS","INDIANA","IOWA","KANSAS",
"KENTUCKY","LOUISIANA","MAINE","MARYLAND","MASSACHUSETTS"),
c("MICHIGAN","MINNESOTA","MISSISSIPPI","MISSOURI","MONTANA",
"NEBRASKA","NEVADA","NEW HAMPSHIRE","NEW JERSEY","NEW MEXICO"),
c("NEW YORK","NORTH CAROLINA","NORTH DAKOTA","OHIO","OKLAHOMA",
"OREGON","PENNSYLVANIA","RHODE ISLAND","SOUTH CAROLINA","SOUTH DAKOTA"),
c("COLORADO","TENNESSEE","TEXAS","UTAH","VERMONT",
"VIRGINIA","WASHINGTON","WEST VIRGINIA","WISCONSIN","WYOMING")
)
# 3) Pick the year(s) you want
years_to_run <- c(2000:2005)  # e.g. repeatable: change or lengthen this vector
# 4) Loop over each year, pull all counties, derive top‑yield crop
survey_top_crop_by_county_all <-
years_to_run |>
lapply(function(yr) {
# 4a) pull county data in five 10‑state chunks
raw_yr <- state_chunks |>
lapply(function(states) {
nassqs(
source_desc           = "SURVEY",
sector_desc           = "CROPS",
group_desc            = c("FIELD CROPS",
"FRUIT & TREE NUTS",
"SPECIALTY",
"VEGETABLES"),
agg_level_desc        = "STATE",
reference_period_desc = "YEAR"
)})
}) |>
bind_rows()
