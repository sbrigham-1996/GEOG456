# install.packages("sf")
library(sf)
library(dplyr)
# 1) read your raw file
counties <- st_read("long_county_crop.geojson", quiet = TRUE)
# 2) filter out the catch‐all county
#    (adjust the exact string if yours is slightly different)
counties <- counties %>%
filter(county_name != "Other Counties County")
# 3) simplify geometry & reduce precision
counties_slim <- counties %>%
# collapse vertices closer than ~0.01° (~1 km)
st_simplify(dTolerance = 0.01, preserveTopology = TRUE) %>%
# snap coordinates to a 1 e–3 grid (~100 m)
st_set_precision(1e3) %>%
st_make_valid()
# 4) write back out
st_write(
counties_slim,
"long_county_crop_slim.geojson",
driver     = "GeoJSON",
delete_dsn = TRUE
)
st_write(long_state, "long_state_crop.geojson", driver = "GeoJSON", delete_dsn = TRUE)
# 4) write back out
st_write(
counties_slim,
"long_county_crop_slim.geojson",
driver     = "GeoJSON",
delete_dsn = TRUE
)
View(counties_slim)
library(sf)
library(dplyr)
# 1) read your slimmed county file
counties_slim <- st_read("long_county_crop_slim.geojson", quiet = TRUE)
# 2) for each state, keep only the top 5 counties by Value_num
top5_per_state <- counties_slim %>%
# ensure your numeric field is really numeric
mutate(Value_num = as.numeric(Value_num)) %>%
group_by(state_name) %>%
slice_max(order_by = Value_num, n = 5, with_ties = FALSE) %>%
ungroup()
# 3) write that tiny subset out
st_write(
top5_per_state,
"long_county_crop_top5_per_state.geojson",
driver     = "GeoJSON",
delete_dsn = TRUE
)
View(top5_per_state)
library(sf)
library(dplyr)
# 1) Read in your already‑slimmed, long‑format county GeoJSON
counties_slim <- st_read("long_county_crop_slim.geojson", quiet = TRUE)
# 2) Within each state × year, keep only the top 5 counties by Value_num
top5_by_state_year <- counties_slim %>%
mutate(Value_num = as.numeric(Value_num)) %>%
group_by(state_name, year) %>%
slice_max(order_by = Value_num, n = 5, with_ties = FALSE) %>%
ungroup()
# 3) Write out this smaller GeoJSON
st_write(
top5_by_state_year,
"long_county_crop_top5_by_state_year.geojson",
driver     = "GeoJSON",
delete_dsn = TRUE
)
View(top5_by_state_year)
unique(top5_by_state_year)
unique(top5_by_state_year$commodity_desc
