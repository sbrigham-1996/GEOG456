library(rnassqs)
library(dplyr)
nassqs_auth("9E6A687A-B7F5-3950-B4BA-8511C501D06B")
all_states <- state.abb
survey_pieces <- function(st) {
nassqs(
source_desc       = "SURVEY",
sector_desc       = "CROPS",
statisticcat_desc = "PRODUCTION",
state_alpha       = st,
agg_level_desc    = "STATE",
unit_desc         = "$",
year              = 2000,
reference_period_desc = "YEAR"
)
}
# iterate, but skip states that error out instead of stopping the whole run
results <- lapply(all_states, \(st)
tryCatch(survey_pieces(st), error = \(e) {message("skipped ", st); NULL})
)
survey_crops_2000 <- bind_rows(Filter(Negate(is.null), results))
# clean & get top-value crop
top_crop_by_state_2000 <- survey_crops_2000 %>%
filter(
!commodity_desc %in% c("HAY & HAYLAGE",
"FRUIT & TREE NUT TOTALS",
"VEGETABLE TOTALS"),
!short_desc %in% c(
"NON-CITRUS FRUIT & TREE NUTS TOTALS - PRODUCTION, MEASURED IN $",
"FIELD CROP TOTALS, INCL POTATOES & OTHER - PRODUCTION, MEASURED IN $"
)
) %>%
mutate(value_num = as.numeric(gsub(",", "", Value))) %>%
filter(!is.na(value_num)) %>%
group_by(state_name) %>%
slice_max(value_num, n = 1, with_ties = FALSE) %>%
ungroup() %>%
select(year, state_name, commodity_desc, Value)
