})
library(rnassqs)
library(dplyr)
# ——————————————
# 0) Authenticate once
# ——————————————
nassqs_auth("9E6A687A-B7F5-3950-B4BA-8511C501D06B")
# ——————————————
# 1) Build your full list of state/territory codes
# ——————————————
all_states <- c(state.abb)
# ——————————————
# 3) For each chunk, hit the API and collect results
# ——————————————
survey_pieces <- lapply(all_states, function(states) {
nassqs(
source_desc           = "SURVEY",
sector_desc           = "CROPS",
statisticcat_desc     = "PRODUCTION",
state_alpha           = states,
year                  = 2000,
reference_period_desc = "YEAR"
)
})
# ——————————————
# 4) Bind them into one data frame
# ——————————————
survey_crops_2000 <- bind_rows(survey_pieces)
# ——————————————
# 5) Clean up unwanted totals
# ——————————————
survey_crops_2000 <- survey_crops_2002 %>%
filter(
!commodity_desc %in% c("HAY & HAYLAGE",
"FRUIT & TREE NUT TOTALS",
"VEGETABLE TOTALS"),
!short_desc %in% c(
"NON-CITRUS FRUIT & TREE NUTS TOTALS - PRODUCTION, MEASURED IN $",
"FIELD CROP TOTALS, INCL POTATOES & OTHER - PRODUCTION, MEASURED IN $"
)
)
