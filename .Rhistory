library(sf)
library(dplyr)
library(tigris)
library(stringr)
crop_data <- read.csv("combined_top_crops_2000_2020.csv")
# Make sure the state names column matches the shapefile's naming convention (e.g. "NAME")
head(crop_data)
# Option 1: Using tigris (requires internet)
options(tigris_use_cache = TRUE)
states_sf <- states(cb = TRUE)
states_sf <- states_sf %>%
filter(!NAME %in% c("American Samoa",
"Guam",
"District of Columbia",
"Commonwealth of the Northern Mariana Islands",
"United States Virgin Islands",
"Puerto Rico"))
# Convert all uppercase state names to title case
crop_data <- crop_data %>%
mutate(state_name = str_to_title(state_name))
# Join by state name
crop_data <- states_sf %>%
left_join(crop_data, by = c("NAME" = "state_name"))
states_crop_sf_clean <- states_crop_sf |>
mutate(Value_num = as.numeric(Value)) |>
filter(!is.na(Value_num)) |>
group_by(state_name, county_name) |>
slice_max(order_by = Value_num, n = 1, with_ties = FALSE) |>
ungroup() |>
select(year, state_name, county_name, commodity_desc, unit_desc, Value_num)
